def logical_calculator():
    print("--- Калькулятор булевой логики ---")
    print("Введите 1 для True или 0 для False")
    
    # Ввод значений
    a = bool(int(input("Введите первое значение (A): ")))
    b = bool(int(input("Введите второе значение (B): ")))
    
    print("\n--- Результаты ---")
    print(f"NOT A: {not a}")
    print(f"A AND B: {a and b}")
    print(f"A OR B: {a or b}")
    print(f"A XOR B: {a != b}")

# Запуск
logical_calculator()
