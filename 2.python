def logical_calculator_part2():
    print("\n--- Продвинутая логика ---")
    
    # Ввод значений
    a = bool(int(input("Введите первое значение (A): ")))
    b = bool(int(input("Введите второе значение (B): ")))
    
    # Вычисления
    implication = (not a) or b  # А влечет B
    equivalence = (a == b)      # А эквивалентно B
    
    print("\n--- Результаты ---")
    print(f"A -> B (Импликация): {implication}")
    print(f"A <-> B (Эквивалентность): {equivalence}")

# Запуск
logical_calculator_part2()
